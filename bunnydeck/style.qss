/* Bunny Deck — minimalist dark theme (Qt style sheet).
 * The main window is translucent so a terminal's background alpha can show
 * the desktop; every non-terminal surface paints its own solid background. */

QWidget {
    color: #c9ced6;
}

QDialog, QMenu, QToolTip, QMessageBox {
    background-color: #121418;
    color: #c9ced6;
}

QToolTip {
    border: 1px solid #1f232a;
}

/* ----- Shared controls: one design language everywhere -------------------
 * Radius 6 px, borders #262b33, accent #5b8def (focus, selection), primary
 * blue #2f5fbf for the main button of a view or dialog (theme.py). */

QPushButton {
    background-color: #16191e;
    color: #c9ced6;
    border: 1px solid #262b33;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1d2128;
    border-color: #323844;
}

QPushButton:pressed {
    background-color: #22262e;
}

QPushButton:checked {
    background-color: #16233b;
    border-color: #2c4677;
    color: #ffffff;
}

QDialogButtonBox QPushButton:default, QPushButton#primaryBtn {
    background-color: #2f5fbf;
    border-color: #3f70d4;
    color: #ffffff;
    font-weight: bold;
}

QDialogButtonBox QPushButton:default:hover, QPushButton#primaryBtn:hover {
    background-color: #3a6cd0;
}

QPushButton:disabled, QPushButton#primaryBtn:disabled {
    background-color: #121418;
    border-color: #1f232a;
    color: #4b5260;
    font-weight: normal;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #0e1013;
    color: #dfe3ea;
    border: 1px solid #262b33;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 18px;
    selection-background-color: #2f5fbf;
}

QSpinBox {
    padding: 3px 4px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #5b8def;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* @HERE@ is replaced with this directory when the style sheet is loaded. */
QComboBox::down-arrow {
    image: url(@HERE@/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* Port fields: type the number, or use the wheel or arrow keys. */
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #121418;
    border: 1px solid #262b33;
    selection-background-color: #1a2436;
}

QMenu {
    border: 1px solid #262b33;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1a2436;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #4b5260;
}

QMenu::separator {
    height: 1px;
    background-color: #1f232a;
    margin: 4px 6px;
}

/* AI menu: a row per assistant (aimenu.py) */
QMenu#aiMenu {
    padding: 6px;
    border-radius: 8px;
}

QLabel#menuHint {
    color: #7d8590;
    font-size: 11px;
    padding: 0px 12px 6px 12px;
}

QLabel#menuHeader {
    color: #6b7280;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 4px 10px 6px 10px;
}

QWidget#aiRow {
    border-radius: 6px;
    min-width: 250px;
}

QWidget#aiRow:hover {
    background-color: #1a2436;
}

QLabel#aiName {
    color: #e6e9ef;
    font-weight: bold;
}

QLabel#aiCommand {
    color: #6b7280;
    font-family: monospace;
    font-size: 11px;
}

QLabel#aiOpen {
    color: #6cc070;
    background-color: rgba(108, 192, 112, 0.16);
    border: 1px solid rgba(108, 192, 112, 0.55);
    border-radius: 8px;
    padding: 0px 7px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#aiEmpty {
    color: #8a919c;
    padding: 2px 10px 8px 10px;
}

/* ----- Connections sidebar ------------------------------------------------ */

#sidebar {
    background-color: #0d0f13;
}

#sidebarTitle {
    color: #6b7280;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
}

#sidebarList, #sidebarList:focus {
    background-color: transparent;
    border: none;
    outline: 0;
}

#sidebarAdd {
    border: none;
    border-radius: 6px;
    padding: 3px;
}

#sidebarAdd:hover {
    background-color: #1a1d23;
}

#bodySplit::handle {
    width: 1px;
    background-color: #1f232a;
}

/* ----- Start screen -------------------------------------------------------- */

#welcomeTitle {
    font-size: 26px;
    font-weight: bold;
    color: #e6e9ef;
}

QPushButton#welcomeCard {
    background-color: #121418;
    border: 1px solid #1f232a;
    border-radius: 8px;
    padding: 12px 14px;
    color: #dfe3ea;
    font-size: 13px;
    text-align: left;
    min-height: 40px;
}

QPushButton#welcomeCard:hover {
    border-color: #5b8def;
    background-color: #151a22;
}

QPushButton#recentRow {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 7px 10px;
    color: #c9ced6;
    text-align: left;
}

QPushButton#recentRow:hover {
    background-color: #15181e;
    color: #ffffff;
}

#deckToolbar {
    background-color: #0a0b0d;
    border-bottom: 1px solid #1f232a;
}

#deckToolbar QToolButton {
    min-height: 26px;
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid transparent;
    background-color: transparent;
    color: #c9ced6;
}

#deckToolbar QToolButton[iconOnly="true"] {
    min-width: 26px;
    padding: 2px 4px;
}

#deckToolbar QToolButton:hover {
    background-color: #1a1d23;
}

#deckToolbar QToolButton:pressed, #deckToolbar QToolButton:open {
    background-color: #20242c;
}

#deckToolbar QToolButton:checked {
    background-color: #16233b;
    border-color: #2c4677;
    color: #ffffff;
}

#deckToolbar QToolButton::menu-indicator {
    image: none;
}

/* New SSH: the one accented button */
#deckToolbar QToolButton#primaryBtn {
    background-color: #2f5fbf;
    border-color: #3f70d4;
    color: #ffffff;
    font-weight: bold;
    padding: 2px 12px 2px 8px;
}

#deckToolbar QToolButton#primaryBtn:hover {
    background-color: #3a6cd0;
}

#deckToolbar QToolButton#savedBtn {
    border-color: #1f232a;
    background-color: #121418;
    padding: 2px 10px 2px 6px;
}

#deckToolbar QToolButton#savedBtn:hover {
    background-color: #1a1d23;
}

#toolbarSep {
    background-color: #1f232a;
}

/* Side by side / stacked: one segmented control */
#splitSegment {
    border: 1px solid #1f232a;
    border-radius: 6px;
    background-color: #0e1013;
}

#deckToolbar #splitSegment QToolButton {
    border: none;
    border-radius: 0px;
    min-width: 30px;
}

#deckToolbar #splitSegment QToolButton#segLeft {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

#deckToolbar #splitSegment QToolButton#segRight {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

#deckToolbar #splitSegment QToolButton:checked {
    background-color: #1d2a44;
}

#emptyState, #fmRoot, QStackedWidget > QWidget#fmRoot, #fmTop {
    background-color: #0a0b0d;
}

#emptyTitle {
    font-size: 15px;
    color: #c9ced6;
}

#dimLabel {
    color: #6b7280;
}

#errorLabel {
    color: #e0605d;
    padding: 4px 8px;
}

/* Divider between panels. */
QSplitter::handle {
    background-color: #1f232a;
}

QSplitter::handle:hover {
    background-color: #5b8def;
}

#termPanel {
    background-color: transparent;
    border: 1px solid #1f232a;
}

#termPanel[active="true"] {
    border-color: #2c3a55;
}

#termHeader {
    background-color: #121418;
    border-top: 2px solid transparent;
    border-bottom: 1px solid #1f232a;
    min-height: 22px;
    max-height: 22px;
}

#termHeader QLabel {
    font-size: 11px;
    color: #6b7280;
}

#termHeader QLabel#termName {
    color: #c9ced6;
    font-weight: bold;
}

/* Logged in as root: a red badge next to the name. */
#termHeader QLabel#rootBadge {
    color: #ffffff;
    background-color: #c0392b;
    border-radius: 3px;
    padding: 0px 5px;
    font-size: 10px;
    font-weight: bold;
}

/* The stats button: chart icon + ping, coloured by how fast it is. */
#termHeader QToolButton#statsBtn {
    font-family: monospace;
    font-size: 10px;
    padding: 1px 4px;
}

#termHeader QToolButton#statsBtn[level="good"] { color: #4fb37a; }
#termHeader QToolButton#statsBtn[level="fair"] { color: #e0a43a; }
#termHeader QToolButton#statsBtn[level="slow"] { color: #e5534b; }

/* user@host: readable at a glance, a step below the name. */
#termHeader QLabel#termTarget {
    color: #9aa3b0;
    font-family: monospace;
    padding-left: 2px;
}

#statusDot {
    font-size: 9px;
}

#statusDot[state="ok"] { color: #6cc070; }
#statusDot[state="error"] { color: #e0605d; }
#statusDot[state="connecting"] { color: #e5c07b; }
#statusDot[state="off"] { color: #6b7280; }

#termHeader QToolButton {
    font-size: 11px;
    color: #6b7280;
    border: none;
    border-radius: 4px;
    padding: 1px 3px;
    min-height: 16px;
    background: transparent;
}

#termHeader QToolButton::menu-indicator {
    image: none;
}

#termHeader QToolButton:hover {
    color: #c9ced6;
    background-color: #1f232a;
}

/* Reconnect: shown when a session has ended. */
#termHeader QToolButton#reconnectBtn {
    color: #ffffff;
    background-color: #2f5fbf;
    border-radius: 4px;
    padding: 1px 8px 1px 6px;
    font-weight: bold;
}

#termHeader QToolButton#reconnectBtn:hover {
    color: #ffffff;
    background-color: #3d70d6;
}

#termHeader QToolButton#hdrClose:hover {
    color: #ffffff;
    background-color: #8a2d2b;
}

/* Thin terminal scrollbar. */
#termPanel QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

#termPanel QScrollBar::handle:vertical {
    background: rgba(200, 205, 214, 0.35);
    min-height: 24px;
    border-radius: 3px;
    margin: 1px 2px;
}

#termPanel QScrollBar::handle:vertical:hover {
    background: rgba(200, 205, 214, 0.7);
}

#termPanel QScrollBar::add-line, #termPanel QScrollBar::sub-line,
#termPanel QScrollBar::add-page, #termPanel QScrollBar::sub-page {
    height: 0;
    background: transparent;
}

/* Held by its header to be moved: the whole terminal lights up. */
#termPanel[grabbed="true"], #termPanel[grabbed="true"][active="true"],
#termPanel[grabbed="true"][broadcast="true"] {
    border: 2px solid #5b8def;
}

#termPanel[grabbed="true"] #termHeader,
#termPanel[grabbed="true"][broadcast="true"] #termHeader {
    background-color: #2f5fbf;
}

#termPanel[grabbed="true"] #termHeader QLabel,
#termPanel[grabbed="true"] #termHeader QLabel#termTarget,
#termPanel[grabbed="true"] #termHeader QLabel#termStatus {
    color: #dce6fb;
}

#grabTint {
    background-color: rgba(91, 141, 239, 0.16);
    border: 2px solid #5b8def;
}

#termPanel[grabbed="true"] #termHeader QLabel#termName {
    color: #ffffff;
}

/* Broadcast: ticked terminals and the toolbar button turn orange. */
#termPanel[broadcast="true"], #termPanel[broadcast="true"][active="true"] {
    border-color: #e8913a;
}

#termPanel[broadcast="true"] #termHeader {
    background-color: #2a1d10;
}

/* The tick box must stand out on the dark header. */
#termHeader QCheckBox#broadcastBox::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #e8913a;
    border-radius: 2px;
    background-color: #121418;
}

#termHeader QCheckBox#broadcastBox::indicator:checked {
    background-color: #e8913a;
    image: url(@HERE@/check.svg);
}

#deckToolbar QToolButton#broadcastBtn:checked {
    border-color: #e8913a;
    background-color: #2a1d10;
    color: #f0a35a;
    font-weight: bold;
}

QPushButton#deleteBtn:hover {
    background-color: #8a2d2b;
    color: #ffffff;
}

/* Network Scan window */
#netScanRoot {
    background-color: #0a0b0d;
}

#netSide {
    background-color: #0d0f13;
    border-left: 1px solid #1f232a;
}

#netHeading {
    font-weight: bold;
    color: #e6e9ef;
}

#netList {
    background-color: #0a0b0d;
    border: 1px solid #1f232a;
    border-radius: 4px;
}

#netList::item {
    padding: 4px 2px;
}

#netList::item:selected {
    background-color: #1a2436;
    color: #ffffff;
}

#netDetails {
    background-color: #0a0b0d;
    border: 1px solid #1f232a;
    border-radius: 4px;
    padding: 8px;
}

#nmapMissing {
    background-color: #2a1f0e;
    border-bottom: 1px solid #5c4318;
}

#scanProgress {
    border: none;
    background-color: #12161c;
}

#scanProgress::chunk {
    background-color: #3ddc84;
}

#netScanRoot QPushButton:disabled {
    color: #4b5260;
}

/* ----- Snap layouts popup ------------------------------------------------ */

#snapPopup {
    background-color: #121418;
    border: 1px solid #2c323c;
    border-radius: 10px;
}

#snapTitle {
    color: #e6e9ef;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#snapMore {
    text-align: left;
}

/* ----- File manager ------------------------------------------------------- */

#fmTop {
    background-color: #0a0b0d;
}

#fmTitle {
    font-size: 18px;
    font-weight: bold;
    color: #e6e9ef;
}

#fmPane {
    background-color: #0d0f13;
    border: 1px solid #1f232a;
    border-radius: 10px;
}

#fmPaneHeader {
    background-color: transparent;
    border-bottom: 1px solid #1f232a;
}

#fmPane QToolButton#fmTool, #fmPane QToolButton#deleteBtn {
    border: none;
    border-radius: 6px;
    padding: 4px;
    background: transparent;
}

#fmPane QToolButton#fmTool:hover, #fmPane QToolButton#deleteBtn:hover {
    background-color: #1d2128;
}

#fmPane QToolButton#fmTool:checked {
    background-color: #16233b;
}

#fmPane QToolButton#deleteBtn:hover {
    background-color: #8a2d2b;
}

#pathBar #crumbs {
    background-color: #0a0b0d;
    border: 1px solid #262b33;
    border-radius: 6px;
}

#pathBar #crumbs:hover {
    border-color: #323844;
}

QToolButton#crumb {
    border: none;
    border-radius: 4px;
    padding: 2px 5px;
    color: #9aa3b2;
    background: transparent;
}

QToolButton#crumb:hover {
    background-color: #1d2128;
    color: #ffffff;
}

QToolButton#crumb[current="true"] {
    color: #e6e9ef;
    font-weight: bold;
}

#crumbSep {
    color: #4b5260;
    padding: 0 1px;
}

#fmPane QTreeWidget {
    background-color: transparent;
    border: none;
    outline: 0;
}

#fmPane QTreeWidget::item {
    padding: 3px 2px;
    border: none;
}

#fmPane QTreeWidget::item:hover {
    background-color: #15181e;
}

#fmPane QTreeWidget::item:selected {
    background-color: #1a2a48;
    color: #ffffff;
}

#fmPane QHeaderView::section {
    background-color: transparent;
    color: #6b7280;
    border: none;
    border-bottom: 1px solid #1f232a;
    padding: 4px 6px;
    font-size: 11px;
}

QToolButton#copyBtn {
    background-color: #2f5fbf;
    border: 1px solid #3f70d4;
    border-radius: 19px;
    min-width: 36px;
    min-height: 36px;
    max-width: 36px;
    max-height: 36px;
}

QLabel#copyCaption {
    color: #aab1bd;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

QToolButton#copyBtn:hover {
    background-color: #3a6cd0;
}

QToolButton#copyBtn:disabled {
    background-color: #1a1d23;
    border-color: #262b33;
}

#fmStatusbar {
    background-color: #0a0b0d;
}

#fmProgress {
    border: none;
    border-radius: 3px;
    background-color: #1d2128;
}

#fmProgress::chunk {
    border-radius: 3px;
    background-color: #5b8def;
}

/* ----- Polish: dialogs, check boxes, scroll bars, tool tips ---------------- */

QToolTip {
    padding: 5px 8px;
    border: 1px solid #2c323c;
    border-radius: 6px;
}

#dialogTitle {
    font-size: 16px;
    font-weight: bold;
    color: #e6e9ef;
}

#sectionTitle {
    color: #6b7280;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#keycap {
    background-color: #1d2128;
    border: 1px solid #323844;
    border-bottom: 2px solid #323844;
    border-radius: 5px;
    padding: 1px 7px;
    color: #e6e9ef;
    font-size: 11px;
}

QToolButton#swatch, QToolButton#swatchCustom {
    border: 2px solid #262b33;
    border-radius: 15px;
}

QToolButton#swatch:hover, QToolButton#swatchCustom:hover {
    border-color: #4b5260;
}

QToolButton#swatch:checked {
    border: 2px solid #5b8def;
}

QToolButton#swatchCustom {
    background-color: #16191e;
    color: #9aa3b2;
    font-size: 16px;
    font-weight: bold;
}

QLabel#imageThumb {
    background-color: #0e1013;
    border: 1px solid #262b33;
    border-radius: 6px;
    color: #4b5260;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #262b33;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #5b8def;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #e6e9ef;
    border: 2px solid #5b8def;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 8px;
}

QCheckBox::indicator, QListView::indicator, QTreeView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3a404b;
    border-radius: 4px;
    background-color: #0e1013;
}

QCheckBox::indicator:hover, QListView::indicator:hover {
    border-color: #5b8def;
}

QCheckBox::indicator:checked, QListView::indicator:checked, QTreeView::indicator:checked {
    background-color: #2f5fbf;
    border-color: #3f70d4;
    image: url(@HERE@/check.svg);
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #2c323c;
    min-height: 28px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4b5260;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #2c323c;
    min-width: 28px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: transparent;
}

/* A file pane that cannot show its folder: a card, not just red text. */
#fmPane QLabel#errorLabel {
    background-color: #2a1416;
    border: 1px solid #5c2b2b;
    border-radius: 8px;
    color: #f0a0a0;
}

#fmPane QLabel#dimLabel {
    padding: 4px 12px;
}

QListWidget {
    background-color: #0e1013;
    border: 1px solid #262b33;
    border-radius: 6px;
    outline: 0;
}

QListWidget::item {
    padding: 4px 4px;
}

QListWidget::item:selected {
    background-color: #1a2436;
    color: #ffffff;
}

/* Stats popup (chart icon in a terminal header) */
#statsPopup {
    background-color: #121418;
    border: 1px solid #2c323c;
    border-radius: 10px;
}

#statsHost {
    color: #e6e9ef;
    font-weight: bold;
    font-size: 14px;
}

#statsSection {
    color: #6b7280;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

#statsName {
    color: #aab1bd;
    min-width: 64px;
}

#statsValue {
    color: #c9ced6;
    font-family: monospace;
    font-size: 11px;
    min-width: 120px;
}

#statsProc {
    color: #aab1bd;
    font-family: monospace;
    font-size: 11px;
}

/* Docker panel (dockerpanel.py) */
QLabel#dockerMessage {
    color: #8a919c;
    padding: 24px;
    background-color: #0e1013;
}

QTreeWidget#dockerTree {
    background-color: #0e1013;
    border: none;
    color: #c9ced6;
    font-size: 12px;
    outline: none;
}

QTreeWidget#dockerTree::item {
    padding: 3px 2px;
}

QTreeWidget#dockerTree::item:selected {
    background-color: #1a2436;
    color: #ffffff;
}

QTreeWidget#dockerTree::item:hover:!selected {
    background-color: #15181e;
}

QTreeWidget#dockerTree QHeaderView::section {
    background-color: #121418;
    color: #6b7280;
    border: none;
    border-bottom: 1px solid #1f232a;
    padding: 4px 6px;
    font-size: 10px;
    font-weight: bold;
}

/* Firewall window (firewalldialog.py) */
QLabel#fwBanner {
    border-radius: 8px;
    padding: 8px 10px;
    border: 1px solid #262b33;
    background-color: #15181e;
    color: #c9ced6;
}

QLabel#fwBanner[level="ok"] {
    border-color: rgba(108, 192, 112, 0.5);
    background-color: rgba(108, 192, 112, 0.10);
    color: #9bd89e;
}

QLabel#fwBanner[level="warn"] {
    border-color: rgba(224, 164, 58, 0.55);
    background-color: rgba(224, 164, 58, 0.10);
    color: #f0c27a;
}

QLabel#fwBanner[level="bad"] {
    border-color: #5c2b2b;
    background-color: #2a1416;
    color: #f0a0a0;
}

QLabel#fwWarning {
    color: #f0a0a0;
    background-color: #2a1416;
    border: 1px solid #5c2b2b;
    border-radius: 6px;
    padding: 6px 8px;
}

QLabel#fwPreview {
    font-family: monospace;
    color: #c9ced6;
    background-color: #0a0b0d;
    border: 1px solid #1f232a;
    border-radius: 6px;
    padding: 8px 10px;
}

QTreeWidget#fwRules {
    background-color: #0e1013;
    border: 1px solid #1f232a;
    border-radius: 6px;
    font-size: 12px;
}

QTreeWidget#fwRules::item {
    padding: 3px 2px;
}

QTreeWidget#fwRules::item:selected {
    background-color: #1a2436;
    color: #ffffff;
}

/* Radio buttons, in the style of the check boxes */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3a404b;
    border-radius: 8px;
    background-color: #0e1013;
}

QRadioButton::indicator:hover {
    border-color: #5b8def;
}

QRadioButton::indicator:checked {
    border: 4px solid #5b8def;
    background-color: #ffffff;
    width: 8px;
    height: 8px;
}

QRadioButton::indicator:disabled {
    border-color: #262b33;
}

/* Compose view (composeview.py) */
QPlainTextEdit#composeText {
    background-color: #0e1013;
    color: #c9ced6;
    border: none;
    selection-background-color: #1a2436;
}

QTabWidget#composeTabs, QTabWidget#composeTabs QTabBar {
    background-color: #121418;
}

QTabWidget#composeTabs::pane {
    border: none;
}

QTabWidget#composeTabs QTabBar::tab {
    background: #121418;
    color: #8a919c;
    padding: 5px 12px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabWidget#composeTabs QTabBar::tab:selected {
    color: #e6e9ef;
    border-bottom: 2px solid #5b8def;
}

/* Toast: a short message at the bottom right (toast.py) */
QFrame#toast {
    background-color: #1a1d23;
    border: 1px solid #2c323c;
    border-radius: 10px;
}

QFrame#toast[error="true"] {
    border-color: #5c2b2b;
    background-color: #2a1416;
}

QLabel#toastText {
    color: #e6e9ef;
}
